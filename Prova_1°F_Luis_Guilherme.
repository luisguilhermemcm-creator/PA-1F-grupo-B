        "# 6\n",
        "\n",
        "# Crie um programa que leia o salário de um funcionário e sua pontuação de desempenho.\n",
        "# O programa deve calcular um bônus de acordo com as regras:\n",
        "# Pontuação menor que 5: sem bônus\n",
        "# Pontuação de 5 a 7: bônus de 5% do salário\n",
        "# Pontuação de 8 a 9: bônus de 10% do salário\n",
        "# Pontuação igual a 10: bônus de 15% do salário\n",
        "\n",
        "#Entrada\n",
        "\n",
        "salário = float(input(\"Digite o seu salário: \"))\n",
        "pontuação = int(input(\"Digite a sua pontuação: \"))\n",
        "\n",
        "#Processamento\n",
        "\n",
        "if pontuação < 5:\n",
        "  print(\"Você não receberá bônus\")\n",
        "\n",
        "elif pontuação >= 5 and pontuação <= 7:\n",
        "  bonus = salário * 0.05\n",
        "  salário + bonus\n",
        "  print(f\"Você receberá um bônus de R${bonus} e seu salário será de {salário + bonus}\")\n",
        "\n",
        "elif pontuação >= 8 and pontuação <= 9:\n",
        "  bonus2 = salário * 0.1\n",
        "  salário + bonus2\n",
        "  print(f\"Você receberá um bônus de R${bonus2} e seu salário será de {salário + bonus2}\")\n",
        "\n",
        "else :\n",
        "  bonus3 = salário * 0.15\n",
        "  salário + bonus3\n",
        "  print(f\"Você receberá um bônus de R${bonus3} e seu salário será de {salário + bonus3}\")\n",
        "\n"
